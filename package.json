{
  "name": "kern",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json",
    "kern": "tsx --env-file=.env src/bin.ts",
    "demo": "tsx examples/demo/index.ts",
    "demo:reset": "tsx examples/demo/reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "tsx": "latest"
  }
}
